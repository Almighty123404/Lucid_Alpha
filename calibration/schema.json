{
  "$schema": "calibration-record/1",
  "config_version": "1.0.0",
  "description": "One record per real Brain submission: expression + settings + real metrics vs simulator prediction. Used to tighten APPROX-marked constants (delay mechanics, sub-universe formula, coverage, returns denominator).",
  "required": ["expression", "settings", "real_metrics", "predicted_metrics"],
  "example": {
    "expression": "rank(ts_delta(ebitda, 63) / assets)",
    "settings": {
      "region": "USA", "universe": "TOP3000", "delay": 1, "decay": 4,
      "truncation": 0.1, "neutralization": "INDUSTRY", "pasteurization": "ON",
      "nanHandling": "ON", "unitHandling": "VERIFY",
      "language": "FASTEXPR", "instrumentType": "EQUITY"
    },
    "real_metrics": {"sharpe": 1.31, "fitness": 1.05, "turnover_pct": 12.4, "returns_pct": 3.1, "margin_bps": 5.2, "weight_concentration_pct": 4.0, "subuniverse_sharpe": 0.9},
    "predicted_metrics": {"sharpe": 2.30, "fitness": 1.59, "turnover_pct": 1.52, "returns_pct": 5.94, "margin_bps": 77.8, "weight_concentration_pct": 0.66, "subuniverse_sharpe": 1.9},
    "notes": "simulator optimistic on turnover (decay) — recalibrate decay/turnover mapping"
  }
}
